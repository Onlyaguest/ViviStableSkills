{
  "name": "article-remotion-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts ArticleVideo out/article-video.mp4 --codec=h264 --crf=18",
    "stills": "node scripts/render-stills.mjs",
    "check": "npm run typecheck && npm run build && npm run stills"
  },
  "dependencies": {
    "@remotion/cli": "4.0.332",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.332"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
