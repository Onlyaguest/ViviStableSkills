# Input directories (relative to this tool dir unless you use absolute paths)
REPORTS_DIR=reports
ASSETS_DIR=assets

# Site meta
SITE_TITLE=Data Showcase
SITE_SUBTITLE=Static reports for humans

# Build output directory
OUT_DIR=out/site

# Limits (avoid generating huge HTML)
MAX_TABLE_ROWS=200
MAX_CHART_POINTS=500

# Auto reports from CSV (optional)
AUTO_REPORT_FROM_CSV=1
AUTO_REPORT_PROFILE_ROWS=5000
AUTO_REPORT_MAX_UNIQUE_CATEGORIES=20

# Publish (optional)
# - mode=branch: push built site to a dedicated branch in THIS repo (HTML-only branch)
# - mode=repo:  push built site to a SEPARATE repo (recommended for "only HTML" + reuse for all reports)
PUBLISH_MODE=repo

# mode=branch
PUBLISH_REMOTE=origin
PUBLISH_BRANCH=site
PUBLISH_WORKTREE_DIR=.publish-worktree

# mode=repo
PUBLISH_REPO_URL=git@github.com:YOUR_ORG/YOUR_STATIC_SITE_REPO.git
PUBLISH_REPO_BRANCH=main
PUBLISH_REPO_DIR=.publish-repo
